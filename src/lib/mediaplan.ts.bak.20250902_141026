  meta: CampaignMeta;
  rows: PlacementRow[];
  warnings: string[];
  errors: string[];
  source: { fileName: string; sheet: string; headerRow: number; headers: string[] };
};

/** ===== Константы для разметки/валидации ===== */
export const REQUIRED_KEYS: (keyof PlacementRow)[] = [
  "supplier","platform_name","format","environment","measurement_type","code_type"
];

export const TARGET_KEYS: (keyof PlacementRow)[] = [
  ...REQUIRED_KEYS,
  "banner_name","target_url","time_start","time_end","hosting","vast_version"
];

