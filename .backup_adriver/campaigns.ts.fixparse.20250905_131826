export const purgeOldDeleted = (days=30) => {
  const cutoff = Date.now() - days*86400000;
  write(K_DELD, listDeleted().filter(d=>new Date(d.deletedAt).getTime() >= cutoff));
};

export type Ctx = {
  q?: string;
  groupByBrand?: boolean;
  own?: boolean;
  delegated?: boolean;
  status?: "all"|"active"|"inactive";
  brands?: string[];
  ids?: number[];
  collapsed?: string[]; // бренды
};
export const readCtx = ():Ctx => read<Ctx>(K_CTX, { groupByBrand:true, own:true, delegated:true, status:"all", brands:[], ids:[] });
export const saveCtx = (p:Partial<Ctx>) => {
  const cur = readCtx();
  write(K_CTX, { ...cur, ...p });
};

export const exportCsv = (rows:Campaign[]) => {
  const esc = (s:string|number) => `"${String(s).replaceAll('"','""')}"`;
  const header = ["ID","Название","Бренд","Рекламодатель","Тип","Статус","Обновлён"].map(esc).join(",");
  const body = rows.map(r => [r.id,r.name,r.brand,r.advertiser,r.type,r.status,r.updatedAt].map(esc).join(",")).join("\n");
  const blob = new Blob([header+"\n"+body], { type:"text/csv;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = "campaigns.csv"; a.click(); URL.revokeObjectURL(url);
};

export const applyFilters = (all:Campaign[], ctx:Ctx) => {
  const q = (ctx.q||"").trim().toLowerCase();
  const brandSet = new Set(ctx.brands||[]);
  const idSet = new Set(ctx.ids||[]);
  return all.filter(c=>{
    if(ctx.status==="active" && c.status!=="Активна") return false;
    if(ctx.status==="inactive" && c.status!=="Не активна") return false;
    if(ctx.own===false && c.type==="Собственная") return false;
    if(ctx.delegated===false && c.type==="Делегированная") return false;
    if(brandSet.size>0 && !brandSet.has(c.brand)) return false;
    if(idSet.size>0 && !idSet.has(c.id)) return false;
    if(!q) return true;
    const s = `${c.id} ${c.name} ${c.brand}`.toLowerCase();
    return s.includes(q);
  });
};

/** Экспорт в Excel (.xls) без сторонних либ — Excel-совместимая HTML-таблица. */
export const exportExcel = (rows: Campaign[]) => {
  const esc = (s: string | number) =>
    String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const header = ["ID","Название","Бренд","Рекламодатель","Тип","Статус","Обновлён"];
  const thead = `<thead><tr>${header.map(h=>`<th style="font-weight:600;border:1px solid #ccc;background:#f5f5f5;">${esc(h)}</th>`).join("")}</tr></thead>`;
  const tbody = `<tbody>${
    rows.map(r=>
      `<tr>
        <td style="border:1px solid #eee;">${esc(r.id)}</td>
        <td style="border:1px solid #eee;">${esc(r.name)}</td>
        <td style="border:1px solid #eee;">${esc(r.brand)}</td>
        <td style="border:1px solid #eee;">${esc(r.advertiser)}</td>
        <td style="border:1px solid #eee;">${esc(r.type)}</td>
        <td style="border:1px solid #eee;">${esc(r.status)}</td>
        <td style="border:1px solid #eee;">${esc(r.updatedAt)}</td>
      </tr>`
    ).join("")
  }</tbody>`;
  const html = `<!DOCTYPE html><meta charset="UTF-8"><table>${thead}${tbody}</table>`;
  const blob = new Blob([html], { type: "application/vnd.ms-excel;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "campaigns.xls";
  a.click();
  URL.revokeObjectURL(url);
};

