'use client';
import React, { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";

type Campaign = {
  id: number;
  name: string;
  advertiser: string;
  type: "Собственная"|"Делегированная";
  today?: { imps: number; clicks: number; ctr: number };
  yesterday?: { imps: number; clicks: number; ctr: number };
  total?: { imps: number; clicks: number; ctr: number };
};

type BrandGroup = { brand: string; campaigns: Campaign[] };

const DATA: BrandGroup[] = [
  {
    brand: "Бренд 1",
    campaigns: [
      { id: 819306, name: "Летувль_охват_август", advertiser: "АЛЬКОР И КО", type: "Делегированная",
        today:{imps:81010, clicks:101, ctr:0.12}, yesterday:{imps:721, clicks:57, ctr:7.91}, total:{imps:68413907, clicks:121889, ctr:0.18} }
    ]
  },
  {
    brand: "Бренд 2",
    campaigns: [
      { id: 817144, name: "c2c_auto_avito_select_t1_jan-feb_2025_byps", advertiser: "Наталья", type: "Собственная" },
      { id: 815459, name: "Default AD", advertiser: "Наталья", type: "Собственная" },
      { id: 815931, name: "Test1", advertiser: "Наталья", type: "Собственная" }
    ]
  },
  {
    brand: "Бренд 3",
    campaigns: [
      { id: 4471765, name: "Yandex", advertiser: "—", type: "Собственная" }
    ]
  }
];

const K_SELECTED = "adriver/campaigns/selected";

function useSelected() {
  const [selected, setSelected] = useState<Set<number>>(new Set());
  useEffect(() => {
    try {
      const raw = localStorage.getItem(K_SELECTED);
      if (raw) setSelected(new Set(JSON.parse(raw)));
    } catch {}
  }, []);
  useEffect(() => {
    localStorage.setItem(K_SELECTED, JSON.stringify(Array.from(selected)));
  }, [selected]);
  const toggle = (id: number) => setSelected(prev => {
    const next = new Set(prev);
    next.has(id) ? next.delete(id) : next.add(id);
    return next;
  });
  const clear = () => setSelected(new Set());
  const setMany = (ids: number[], checked: boolean) =>
    setSelected(prev => {
      const next = new Set(prev);
      ids.forEach(id => checked ? next.add(id) : next.delete(id));
      return next;
    });
  return { selected, toggle, clear, setMany };
}

export default function CampaignsPage() {
  const router = useRouter();
  const [q, setQ] = useState("");
  const [showOwn, setShowOwn] = useState(true);
  const [showDelegated, setShowDelegated] = useState(true);
  const { selected, toggle, clear, setMany } = useSelected();

  const filtered = useMemo(() => {
    const norm = (s:string) => s.toLowerCase();
    return DATA.map(g => ({
      brand: g.brand,
      campaigns: g.campaigns.filter(c => {
        if (!showOwn && c.type === "Собственная") return false;
        if (!showDelegated && c.type === "Делегированная") return false;
        if (!q) return true;
        const s = `${c.id} ${c.name} ${c.advertiser} ${g.brand}`.toLowerCase();
        return s.includes(norm(q));
      })
    })).filter(g => g.campaigns.length > 0);
  }, [q, showOwn, showDelegated]);

  const gotoDashboard = () => {
    const ids = Array.from(selected);
    if (ids.length === 0) return;
    router.push(`/dashboard?ids=${ids.join(",")}`);
  };
  const gotoBuilder = () => {
    const ids = Array.from(selected);
    if (ids.length === 0) return;
    router.push(`/builder?ids=${ids.join(",")}`);
  };

  return (
    <div className="mx-auto max-w-6xl p-6">
      <header className="mb-4 flex items-center justify-between gap-3">
        <div>
          <h1 className="text-3xl font-bold">Рекламные кампании</h1>
          <p className="text-sm text-gray-600">Стартовый экран: по брендам, с быстрым поиском и действиями.</p>
        </div>
        <Link href="/mediaplan/upload" className="rounded-full bg-sky-600 px-4 py-2 text-sm text-white hover:bg-sky-700">
          Загрузить медиаплан
        </Link>
      </header>

      {/* Поиск и фильтры + массовые действия */}
      <div className="mb-4 flex flex-wrap items-center gap-3">
        <label className="flex items-center gap-2">
          <span className="text-sm text-gray-600">Поиск</span>
          <input
            value={q} onChange={(e)=>setQ(e.target.value)}
            placeholder="ID, название, бренд, рекламодатель"
            className="rounded-md border px-3 py-1.5 text-sm"
          />
        </label>
        <label className="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={showOwn} onChange={(e)=>setShowOwn(e.target.checked)} />
          Собственные
        </label>
        <label className="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={showDelegated} onChange={(e)=>setShowDelegated(e.target.checked)} />
          Делегированные
        </label>

        {selected.size > 0 && (
          <div className="ml-auto flex items-center gap-2 rounded-full bg-sky-50 px-2 py-1 ring-1 ring-sky-200">
            <div className="px-2 text-sm text-sky-900">Выбрано: <b>{selected.size}</b></div>
            <button onClick={gotoDashboard} className="rounded-full bg-sky-600 px-3 py-1.5 text-xs text-white hover:bg-sky-700">
              Дашборд
            </button>
            <button onClick={gotoBuilder} className="rounded-full bg-white px-3 py-1.5 text-xs text-sky-700 ring-1 ring-sky-600 hover:bg-sky-50">
              Конструктор
            </button>
            <button onClick={clear} className="rounded-full px-3 py-1.5 text-xs text-gray-600 hover:bg-gray-50">
              Сбросить
            </button>
          </div>
        )}
      </div>

      {/* Группы по брендам */}
      <div className="space-y-6">
        {filtered.map(group => (
          <BrandBox
            key={group.brand}
            brand={group.brand}
            campaigns={group.campaigns}
            selected={selected}
            onToggle={toggle}
            onToggleAll={(checked:boolean)=>setMany(group.campaigns.map(c=>c.id), checked)}
          />
        ))}
      </div>
    </div>
  );
}

function BrandBox({
  brand, campaigns, selected, onToggle, onToggleAll
}:{
  brand:string;
  campaigns:Campaign[];
  selected:Set<number>;
  onToggle:(id:number)=>void;
  onToggleAll:(checked:boolean)=>void;
}) {
  const router = useRouter();
  const allIds = campaigns.map(c=>c.id);
  const allChecked = allIds.every(id => selected.has(id)) && allIds.length>0;

  // Универсальный обработчик клика по строке:
  // если клик пришёл с <a>, <button>, <input>, <label> или элемента с data-no-rownav — игнорируем.
  const rowNavigate = (e: React.MouseEvent, id: number) => {
    const t = e.target as HTMLElement | null;
    if (!t) return;
    if (t.closest('a,button,input,label,[data-no-rownav]')) return;
    router.push(`/campaigns/new?id=${id}`);
  };

  return (
    <section className="rounded-2xl border bg-white p-4 shadow-sm">
      <div className="mb-2 flex items-center justify-between">
        <div className="text-xl font-semibold">{brand} <span className="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{campaigns.length}</span></div>
        <label className="flex items-center gap-2 text-xs text-gray-600">
          <input
            type="checkbox"
            checked={allChecked}
            onChange={(e)=>onToggleAll(e.target.checked)}
          />
          Выбрать всё в группе
        </label>
      </div>

      <div className="overflow-auto">
        <table className="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th className="bg-gray-100 p-2 text-left w-10"></th>
              <th className="bg-gray-100 p-2 text-left">ID</th>
              <th className="bg-gray-100 p-2 text-left">Название</th>
              <th className="bg-gray-100 p-2 text-left">Рекламодатель</th>
              <th className="bg-gray-100 p-2 text-left">Тип</th>
              <th className="bg-gray-100 p-2 text-left">Сегодня</th>
              <th className="bg-gray-100 p-2 text-left">Вчера</th>
              <th className="bg-gray-100 p-2 text-left">Всего</th>
              <th className="bg-gray-100 p-2 text-right">Действия</th>
            </tr>
          </thead>
          <tbody>
            {campaigns.map(c => (
              <tr
                key={c.id}
                className="cursor-pointer odd:bg-white even:bg-gray-50 hover:bg-sky-50"
                onClick={(e) => rowNavigate(e, c.id)}
              >
                {/* чекбокс — обычный, без stopPropagation; rowNavigate сам игнорирует клики по input */}
                <td className="border-t p-2">
                  <input
                    aria-label="Выбрать кампанию"
                    type="checkbox"
                    checked={selected.has(c.id)}
                    onChange={()=>onToggle(c.id)}
                  />
                </td>

                <td className="border-t p-2 font-mono">{c.id}</td>

                {/* Название — отдельная ссылка (можно кликать и по строке, и по ссылке) */}
                <td className="border-t p-2 text-sky-700 underline-offset-2 hover:underline">
                  <Link href={`/campaigns/new?id=${c.id}`}>{c.name}</Link>
                </td>

                <td className="border-t p-2">{c.advertiser}</td>
                <td className="border-t p-2">{c.type}</td>
                <td className="border-t p-2">{fmtStats(c.today)}</td>
                <td className="border-t p-2">{fmtStats(c.yesterday)}</td>
                <td className="border-t p-2">{fmtStats(c.total)}</td>

                {/* Ячейка действий — помечаем флагом, чтобы rowNavigate её игнорировал */}
                <td className="border-t p-2 text-right" data-no-rownav>
                  <Link href={`/dashboard?ids=${c.id}`} className="mr-2 rounded-full bg-sky-600 px-3 py-1 text-xs text-white hover:bg-sky-700">
                    Дашборд
                  </Link>
                  <Link href={`/builder?ids=${c.id}`} className="rounded-full bg-white px-3 py-1 text-xs text-sky-700 ring-1 ring-sky-600 hover:bg-sky-50">
                    Конструктор
                  </Link>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  );
}

function fmtStats(s?: { imps:number; clicks:number; ctr:number }) {
  if (!s) return "0 / 0 · 0.00%";
  const n = (x:number)=> x.toLocaleString("ru-RU");
  return `${n(s.imps)} / ${n(s.clicks)} · ${s.ctr.toFixed(2)}%`;
}
