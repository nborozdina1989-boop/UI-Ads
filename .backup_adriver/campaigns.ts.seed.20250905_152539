// Lightweight client-only store for prototype (no backend)

export type Campaign = {
  id: number;
  name: string;
  brand?: string;
  advertiser?: string;
  createdAt: string; // ISO
  status: "Активна" | "Не активна";
  type: "Собственная" | "Делегированная";
  pids?: number[];
};

const K_CAMPS = "adr_campaigns";
const K_CTX   = "adr_ctx";

const hasWin = () => typeof window !== "undefined";
const readJSON = <T,>(k: string, fallback: T): T => {
  if (!hasWin()) return fallback as T;
  try { const v = localStorage.getItem(k); return v ? JSON.parse(v) as T : fallback; } catch { return fallback; }
};
const writeJSON = (k: string, v: any) => { if (hasWin()) localStorage.setItem(k, JSON.stringify(v)); };

