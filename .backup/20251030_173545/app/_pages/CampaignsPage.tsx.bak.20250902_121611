'use client';
import React, { useMemo, useState } from "react";
import Link from "next/link";

/**
 * Рекламные кампании (прототип без бэка)
 * — Группировка по Бренду
 * — Поиск по ID/названию/бренду/рекламодателю
 * — Фильтры: Собственные / Делегированные (чек-боксы)
 * — Быстрые действия: Редактировать / Дашборд / Конструктор
 * Стиль: лёгкие карточки, акцент на читаемость (бренд-цвет — sky).
 */

type Owner = "own" | "delegated";
type Stat   = { imps: number; clks: number };
type Total  = { imps: number; clks: number };
type Campaign = {
  id: number;
  name: string;
  brand: string;
  advertiser: string;
  owner: Owner;
  today: Stat;
  yesterday: Stat;
  total: Total;
};

const CAMPAIGNS: Campaign[] = [
  { id: 817144, name: "c2c_auto_avito_select_t1_jan-feb_2025_byps", brand: "Avito Auto", advertiser: "Наталья", owner: "own",
    today:{imps: 0,    clks: 0}, yesterday:{imps: 0,    clks: 0}, total:{imps: 0,      clks: 0} },
  { id: 815459, name: "Default AD",                                   brand: "Avito Auto", advertiser: "Наталья", owner: "own",
    today:{imps: 0,    clks: 0}, yesterday:{imps: 0,    clks: 0}, total:{imps: 0,      clks: 0} },
  { id: 815931, name: "Test1",                                         brand: "Avito Auto", advertiser: "Наталья", owner: "own",
    today:{imps: 0,    clks: 0}, yesterday:{imps: 0,    clks: 0}, total:{imps: 0,      clks: 0} },

  { id: 819306, name: "Летувль_охват_август",                          brand: "Adwatch",    advertiser: "АЛЬКОР И КО", owner: "delegated",
    today:{imps: 81010,clks:101}, yesterday:{imps: 721, clks: 57}, total:{imps: 68413907,clks:121889} },
  { id: 819724, name: "Яндекс_Пэй_Сплит_B2B2C_BTS_Триггер_Август_Сентябрь_2025", brand: "Yandex", advertiser: "Yandex", owner: "delegated",
    today:{imps:143076,clks:206}, yesterday:{imps:2189937,clks:12518}, total:{imps:164081581,clks:520048} },
];

const fmt = (n: number) => new Intl.NumberFormat("ru-RU").format(n);
const pct = (v: number) => `${(v*100).toFixed(2)}%`;
const ctr = (clks:number, imps:number) => (imps ? clks/imps : 0);

function Badge({children}:{children:React.ReactNode}) {
  return <span className="rounded-full bg-sky-50 px-2 py-0.5 text-xs text-sky-700">{children}</span>;
}

function SectionHeader({title, count}:{title:string; count:number}) {
  return (
    <div className="mb-2 flex items-center gap-2">
      <h3 className="text-lg font-semibold">{title}</h3>
      <Badge>{count}</Badge>
    </div>
  );
}


// Отображаемое имя бренда (только для этой страницы)
function brandLabel(raw: string){
  switch (raw) {
    case "Adwatch": return "Бренд 1";
    case "Avito Auto": return "Бренд 2";
    case "Yandex": return "Бренд 3";
    default: return raw || "Без бренда";
  }
}

export default function CampaignsPage() {
  const [q, setQ] = useState("");
  const [showOwn, setShowOwn] = useState(true);
  const [showDeleg, setShowDeleg] = useState(true);

  const filtered = useMemo(() => {
    const term = q.trim().toLowerCase();
    return CAMPAIGNS.filter(c => {
      if (!showOwn && c.owner === "own") return false;
      if (!showDeleg && c.owner === "delegated") return false;
      if (!term) return true;
      return (
        String(c.id).includes(term) ||
        c.name.toLowerCase().includes(term) ||
        c.brand.toLowerCase().includes(term) || brandLabel(c.brand).toLowerCase().includes(term) ||
        c.advertiser.toLowerCase().includes(term)
      );
    });
  }, [q, showOwn, showDeleg]);

  const groups = useMemo(() => {
    const byBrand = new Map<string, Campaign[]>();
    for (const c of filtered) {
      const key = brandLabel(c.brand);
      const arr = byBrand.get(key) || [];
      arr.push(c);
      byBrand.set(key, arr);
    }
    return Array.from(byBrand.entries()).sort(([a],[b])=>a.localeCompare(b));
  }, [filtered]);

  return (
    <div className="mx-auto max-w-6xl p-6">
      <header className="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 className="text-2xl font-bold">Рекламные кампании</h1>
          <p className="text-sm text-gray-500">Стартовый экран: по брендам, с быстрым поиском и действиями.</p>
        </div>
        <div className="flex flex-wrap items-center gap-3">
          <label className="flex items-center gap-2 text-sm">
            <span className="text-gray-600">Поиск</span>
            <input
              value={q}
              onChange={(e)=>setQ(e.target.value)}
              placeholder="ID, название, бренд, рекламодатель"
              className="w-72 rounded-md border px-3 py-1.5 text-sm"
            />
          </label>
          <label className="flex items-center gap-2 text-sm">
            <input type="checkbox" checked={showOwn} onChange={(e)=>setShowOwn(e.target.checked)} />
            <span>Собственные</span>
          </label>
          <label className="flex items-center gap-2 text-sm">
            <input type="checkbox" checked={showDeleg} onChange={(e)=>setShowDeleg(e.target.checked)} />
            <span>Делегированные</span>
          </label>
        </div>
      </header>

      {groups.length === 0 && (
        <div className="rounded-xl border bg-white p-6 text-center text-sm text-gray-500">
          Ничего не найдено. Уточните фильтры или поисковый запрос.
        </div>
      )}

      <div className="space-y-6">
        {groups.map(([brand, rows]) => (
          <section key={brand} className="rounded-xl border bg-white p-4 shadow-sm">
            <SectionHeader title={brand} count={rows.length} />
            <div className="overflow-auto">
              <table className="w-full border-collapse text-sm">
                <thead>
                  <tr>
                    <th className="bg-gray-100 p-2 text-left">ID</th>
                    <th className="bg-gray-100 p-2 text-left">Название</th>
                    <th className="bg-gray-100 p-2 text-left">Рекламодатель</th>
                    <th className="bg-gray-100 p-2 text-left">Тип</th>
                    <th className="bg-gray-100 p-2 text-right">Сегодня</th>
                    <th className="bg-gray-100 p-2 text-right">Вчера</th>
                    <th className="bg-gray-100 p-2 text-right">Всего</th>
                    <th className="bg-gray-100 p-2 text-right">Действия</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map(c => (
                    <tr key={c.id} className="odd:bg-white even:bg-gray-50">
                      <td className="border-t p-2">{c.id}</td>
                      <td className="border-t p-2">
                        <Link href={`/campaigns/${c.id}`} className="text-sky-700 hover:underline">{c.name}</Link>
                      </td>
                      <td className="border-t p-2">{c.advertiser}</td>
                      <td className="border-t p-2">{c.owner === "own" ? "Собственная" : "Делегированная"}</td>
                      <td className="border-t p-2 text-right">
                        <span className="tabular-nums">{fmt(c.today.imps)}</span>
                        {" / "}
                        <span className="tabular-nums">{fmt(c.today.clks)}</span>
                        {" · "}
                        <span className="tabular-nums">{pct(ctr(c.today.clks, c.today.imps))}</span>
                      </td>
                      <td className="border-t p-2 text-right">
                        <span className="tabular-nums">{fmt(c.yesterday.imps)}</span>
                        {" / "}
                        <span className="tabular-nums">{fmt(c.yesterday.clks)}</span>
                        {" · "}
                        <span className="tabular-nums">{pct(ctr(c.yesterday.clks, c.yesterday.imps))}</span>
                      </td>
                      <td className="border-t p-2 text-right">
                        <span className="tabular-nums">{fmt(c.total.imps)}</span>
                        {" / "}
                        <span className="tabular-nums">{fmt(c.total.clks)}</span>
                        {" · "}
                        <span className="tabular-nums">{pct(ctr(c.total.clks, c.total.imps))}</span>
                      </td>
                      <td className="border-t p-2 text-right">
                        <div className="flex justify-end gap-1">
                          <Link href={`/campaigns/${c.id}`} className="rounded-full border px-3 py-1 text-xs hover:bg-gray-50">Редактировать</Link>
                          <Link href={`/dashboard?campaign=${c.id}`} className="rounded-full bg-sky-600 px-3 py-1 text-xs text-white hover:bg-sky-700">Дашборд</Link>
                          <Link href={`/builder?campaign=${c.id}`} className="rounded-full bg-white px-3 py-1 text-xs text-sky-700 ring-1 ring-sky-600 hover:bg-sky-50">Конструктор</Link>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))}
      </div>
    </div>
  );
}
