// Lightweight client-only store for prototype (no backend)

export type Campaign = {
  id: number;
  name: string;
  brand?: string;
  advertiser?: string;
  createdAt: string; // ISO
  status: "Активна" | "Не активна";
  type: "Собственная" | "Делегированная";
  pids?: number[];
};

// ---- Storage helpers
const K_CAMPS = "adr_campaigns";
const K_CTX   = "adr_ctx";

const readJSON = <T,>(k: string, fallback: T): T => {
  if (typeof window === "undefined") return fallback as T;
  try {
    const v = localStorage.getItem(k);
    return v ? (JSON.parse(v) as T) : fallback;
  } catch {
    return fallback;
  }
};

const writeJSON = (k: string, v: any) => {
  if (typeof window !== "undefined") localStorage.setItem(k, JSON.stringify(v));
};

