'use client';
import React, { useMemo, useState } from "react";
import Link from "next/link";
import { listGroups, listCampaigns, deleteGroup } from "@/lib/campaigns";

export default function CampaignGroupsPage(){
  const [data, setData] = useState(listGroups());
  const camps = useMemo(()=> listCampaigns(), []);
  const idsToQuery = (ids:number[]) => ids.join(",");

  const remove = (id:string) => { if(confirm("Удалить группу?")) { deleteGroup(id); setData(listGroups()); } };

  return (
    <div className="mx-auto max-w-7xl p-6">
      <div className="mb-4 flex items-center justify-between">
        <div className="text-2xl font-bold">Группы</div>
        <Link href="/campaigns" className="rounded-full bg-white px-4 py-2 text-sm text-sky-700 ring-1 ring-sky-600 hover:bg-sky-50">← К списку РК</Link>
      </div>

      <div className="rounded-xl border bg-white">
        <table className="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th className="bg-gray-100 p-2 text-left">Название</th>
              <th className="bg-gray-100 p-2 text-left">Кампаний</th>
              <th className="bg-gray-100 p-2 text-left">Обновлена</th>
              <th className="bg-gray-100 p-2 text-right">Действия</th>
            </tr>
          </thead>
          <tbody>
            {data.map(g=>(
              <tr key={g.id} className="odd:bg-white even:bg-gray-50">
                <td className="border-t p-2">{g.name}</td>
                <td className="border-t p-2">{g.campaignIds.length}</td>
                <td className="border-t p-2">{new Date(g.updatedAt).toLocaleString()}</td>
                <td className="border-t p-2 text-right">
                  <Link href={`/dashboard?ids=${idsToQuery(g.campaignIds)}`} className="mr-2 rounded-full bg-sky-600 px-3 py-1 text-xs text-white hover:bg-sky-700">Дашборд</Link>
                  <Link href={`/builder?ids=${idsToQuery(g.campaignIds)}`} className="mr-2 rounded-full bg-white px-3 py-1 text-xs text-sky-700 ring-1 ring-sky-600 hover:bg-sky-50">Конструктор</Link>
                  <button onClick={()=>remove(g.id)} className="rounded-full bg-white px-3 py-1 text-xs text-red-700 ring-1 ring-red-600 hover:bg-red-50">Удалить</button>
                </td>
              </tr>
            ))}
            {data.length===0 && <tr><td colSpan={4} className="py-8 text-center text-gray-500">Пока нет групп</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}
