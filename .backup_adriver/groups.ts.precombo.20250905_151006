// Client-only Groups store for prototype
export type Group = {
  id: string;
  name: string;
  description?: string;
  campaignIds: number[];
  createdAt: string;   // ISO
  updatedAt: string;   // ISO
};

const LS_GROUPS = "adr_groups";
const LS_FAV_GROUPS = "adr_fav_groups";

const hasWin = () => typeof window !== "undefined";
const readJSON = <T,>(k:string,f:T):T => { if(!hasWin()) return f as T; try{const v=localStorage.getItem(k); return v?JSON.parse(v) as T:f;}catch{return f;} };
const writeJSON = (k:string,v:any)=>{ if(hasWin()) localStorage.setItem(k, JSON.stringify(v)); };

// seed
(() => {
  const cur = readJSON<Group[]>(LS_GROUPS, []);
  if (cur.length) return;
  const now = new Date().toISOString();
  writeJSON(LS_GROUPS, [
    { id:"g1", name:"Мои авто-кампании", description:"быстрый доступ", campaignIds:[819306,817144], createdAt:now, updatedAt:now },
    { id:"g2", name:"Тестовые",          description:"",                campaignIds:[815931],       createdAt:now, updatedAt:now },
  ]);
})();

// API
export const listGroups = (): Group[] => readJSON<Group[]>(LS_GROUPS, []);
export const saveGroup = (g: Group) => {
  const list = listGroups();
  const i = list.findIndex(x => x.id === g.id);
  const now = new Date().toISOString();
  const next = { ...g, updatedAt: now, createdAt: g.createdAt || now };
  if (i >= 0) list[i] = next; else list.push(next);
  writeJSON(LS_GROUPS, list);
};
export const deleteGroup = (id: string) => writeJSON(LS_GROUPS, listGroups().filter(g => g.id !== id));

// ⭐ Favorites (Groups)
export const getFavGroupIds = (): string[] => readJSON<string[]>(LS_FAV_GROUPS, []);
export const isFavGroup = (id:string) => getFavGroupIds().includes(id);
export const toggleFavGroup = (id:string) => {
  const cur = new Set(getFavGroupIds());
  cur.has(id) ? cur.delete(id) : cur.add(id);
  writeJSON(LS_FAV_GROUPS, Array.from(cur));
};
