// ---- Public API

// Список кампаний (как есть, без фильтрации по архиву: архив обрабатываем в archfav.ts на уровне страниц)
export const listCampaigns = (): Campaign[] => {
  const arr = readJSON<Campaign[]>(K_CAMPS, []);
  // гарантируем типы
  return arr.map(c => ({
    ...c,
    id: Number(c.id),
    name: String(c.name),
    brand: c.brand ?? "",
    advertiser: c.advertiser ?? "",
    createdAt: c.createdAt || new Date().toISOString(),
    status: (c.status === "Активна" ? "Активна" : "Не активна"),
    type: (c.type === "Делегированная" ? "Делегированная" : "Собственная"),
    pids: Array.isArray(c.pids) ? c.pids : [],
  }));
};

// Экспорт в «Excel»: создаём .xlsx-файл (содержимое — CSV; для прототипа ок)
export const exportExcel = (rows: Campaign[]) => {
  const data = (rows.length ? rows : listCampaigns()).map(c => ([
    c.id,
    c.name.replace(/\n/g, " "),
    c.brand || "",
    c.advertiser || "",
    c.type,
    c.status,
    c.createdAt,
    (c.pids||[]).join(", "),
  ]));

  const header = ["ID","Название","Бренд","Рекламодатель","Тип","Статус","Дата создания","PIDs"];
  const csv = [header, ...data]
    .map(r => r.map(x => {
      const s = String(x ?? "");
      return /[",;\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    }).join(";"))
    .join("\n");

  if (typeof window !== "undefined") {
    const blob = new Blob([csv], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    const ts = new Date().toISOString().slice(0,10);
    a.href = url;
    a.download = `RK_export_${ts}.xlsx`;
    a.click();
    URL.revokeObjectURL(url);
  }
};

// Контекст экрана (фильтры/свернутость и т.п.)
export type Ctx = Partial<{
  q: string;
  own: boolean;
  delegated: boolean;
  status: "all"|"active"|"inactive";
  groupBy: "none"|"brand"|"adv"|"tree";
  collapsed: string[];
}>;

export const readCtx = (): Ctx => readJSON<Ctx>(K_CTX, {});
export const saveCtx = (patch: Ctx) => {
  const cur = readCtx();
  writeJSON(K_CTX, { ...cur, ...patch });
};

// (Опционально) служебная запись кампаний, если когда-то понадобится
export const __saveCampaignsUnsafe = (items: Campaign[]) => writeJSON(K_CAMPS, items);
