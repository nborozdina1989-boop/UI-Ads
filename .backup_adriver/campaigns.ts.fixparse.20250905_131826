const read = <T,>(k:string, def:T):T => { try{ const s=localStorage.getItem(k); return s? JSON.parse(s):def; }catch{ return def; } };
const write = <T,>(k:string, v:T) => localStorage.setItem(k, JSON.stringify(v));

export const listCampaigns = ():Campaign[] => read<Campaign[]>(K_ALL, SEED);
export const saveCampaigns = (arr:Campaign[]) => write(K_ALL, arr);

export const uniqueBrands = ():string[] => Array.from(new Set(listCampaigns().map(c=>c.brand)));

export const listGroups = ():Group[] => read<Group[]>(K_GROUP, []);
export const saveGroup = (g:Group) => {
  const arr = listGroups();
  const i = arr.findIndex(x=>x.id===g.id);
  if(i>=0) arr[i]=g; else arr.unshift(g);
  write(K_GROUP, arr);
};
export const deleteGroup = (id:string) => write(K_GROUP, listGroups().filter(g=>g.id!==id));

export const addToGroup = (gid:string, ids:number[]) => {
  const arr = listGroups(); const i=arr.findIndex(g=>g.id===gid);
  if(i<0) return;
  const set = new Set(arr[i].campaignIds);
  ids.forEach(id=>set.add(id));
  arr[i].campaignIds = Array.from(set);
  arr[i].updatedAt = new Date().toISOString();
  write(K_GROUP, arr);
};

export const listDeleted = ():Deleted[] => read<Deleted[]>(K_DELD, []);
